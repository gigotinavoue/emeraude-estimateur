  "cleaning": {
    "defaultFee": 40,
    "avgStayDefault": "market",
    "adrIncludesCleaningPolicy": "no_adjustment",
    "unknownDefinitionNote": "La source ne précise pas si son prix moyen par nuit inclut les frais de ménage. Aucun ajustement n'est appliqué : le prix de marché est utilisé tel quel, et les frais de ménage de ce logement sont calculés séparément."
  },

  "fees": {
