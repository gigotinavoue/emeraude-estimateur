    },
    "performant": {
      "label": "Performant",
      "positiveBonusFactor": 1,
      "occupancyDeltaSign": 1,
      "managementAdr": 0.03,
      "description": "Le logement capte la demande d'une bonne année (écart annuel observé sur le marché) et bénéficie d'une gestion optimisée (+3 % sur le prix)."
    }
  },

  "months": {
    "defaultMode": "count",
    "defaultCount": 10,
    "labels": ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"],
    "shortLabels": ["Janv.", "Févr.", "Mars", "Avr.", "Mai", "Juin", "Juil.", "Août", "Sept.", "Oct.", "Nov.", "Déc."],
    "referenceYearDays": [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31],
    "countModeNote": "En mode « nombre de mois », les mois retirés sont considérés comme des mois moyens."
  },

  "seasonality": {
    "profiles": {
      "urbain": {
        "label": "Profil urbain",
        "occupancySource": "insee_hotels",
        "adrSource": "adt35_lighthouse",
        "adrDamping": 0.5,
        "basis": "Occupation : profil mensuel de l'hôtellerie en Ille-et-Vilaine (Insee), utilisé comme approximation. Prix : profil mensuel des meublés en Ille-et-Vilaine (Ille & Vilaine Tourisme), amplitude réduite de moitié."
      },
      "littoral": {
        "label": "Profil littoral",
        "occupancySource": "adt35_lighthouse",
        "adrSource": "adt35_lighthouse",
        "adrDamping": 1,
        "basis": "Occupation et prix : profil mensuel des meublés entiers en Ille-et-Vilaine (Ille & Vilaine Tourisme)."
      }
    }
  },

  "freshness": { "greenMaxMonths": 15, "orangeMaxMonths": 27, "pipelineStaleDays": 45 },

  "confidence": {
    "lowGeoLevels": ["departement"],
    "mediumIfSampleNightsBelow": 50000,
    "mediumIfNeighbourMarket": true,
    "freshnessCaps": { "green": "elevee", "orange": "moyenne", "red": "faible" },
    "snapshotCap": "faible",
    "labels": { "elevee": "Élevée", "moyenne": "Moyenne", "faible": "Faible" }
  },

  "emeraude": {
    "minMonthsPerListing": 6,
    "levels": [
      { "id": "observation", "label": "Observation", "minListings": 0, "maxWeight": 0, "maxEffect": 0 },
      { "id": "signal", "label": "Signal", "minListings": 3, "maxWeight": 0, "maxEffect": 0 },
      { "id": "calibration", "label": "Calibration", "minListings": 5, "maxWeight": 0.33, "maxEffect": 0.10 },
      { "id": "solide", "label": "Données internes solides", "minListings": 10, "maxWeight": 0.60, "maxEffect": 0.20 }
    ],
    "weightHalfSaturation": 10,
    "minListingsToPublishAggregate": 3,
    "seasonalityMinListingMonths": 120
  },

  "validation": {
    "adr": [30, 400],
    "occupancy": [0.10, 0.90],
    "avgStay": [1, 15],
    "maxYoyChange": { "adr": 0.30, "occupancy": 0.15 },
    "seasonalIndex": [0.3, 2.5],
    "seasonalNormalisationTolerance": 0.01
  },

  "inputs": {
    "area": [10, 500],
    "bedrooms": [0, 10],
    "bathrooms": [0, 8],
    "guests": [1, 20],
    "months": [1, 12],
    "commissionPct": [0, 50],
    "cleaningFee": [0, 500],
    "avgStay": [1, 30]
  },

  "defaults": {
    "commune": "rennes",
    "type": "t2",
    "bedrooms": 1,
    "bathrooms": 1,
    "area": 40,
    "guests": 2,
    "location": "standard",
    "commissionPct": 20,
    "cleaningFee": 40
  },

  "texts": {
    "attribution": "Sources : Ille & Vilaine Tourisme (données Lighthouse), Eurostat, Insee.",
