{
  "$id": "observation.schema.json",
  "description": "Observation normalisée, quelle que soit la source.",
  "type": "object",
  "required": ["id", "source", "geo", "segment", "metric", "value", "unit", "period", "retrievedAt", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "source": { "type": "string" },
    "geo": {
      "type": "object",
      "required": ["level", "id"],
      "properties": {
        "level": { "enum": ["commune", "epci", "departement", "region", "city"] },
        "id": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "segment": {
      "type": "object",
      "required": ["roomType", "bedrooms"],
      "properties": {
        "roomType": { "enum": ["entire_home", "all", "hotel"] },
        "bedrooms": { "type": "string", "pattern": "^(all|0|1|2|3|4\\+)$" }
      }
    },
    "metric": { "enum": ["adr", "occupancy", "avgStay", "nightsBooked", "revenueMonth", "stays", "guestNights", "occupancyYoyPts", "hotelOccupancy", "calibrationRatioAdr", "calibrationRatioOcc", "calibrationListings"] },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "period": {
      "type": "object",
      "required": ["start", "end", "granularity"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "granularity": { "enum": ["year", "month"] },
        "month": { "type": ["integer", "null"], "minimum": 0, "maximum": 11 }
      }
    },
    "publishedAt": { "type": "string" },
    "retrievedAt": { "type": "string" },
    "definitions": { "type": "object" },
    "status": { "enum": ["ok", "rejected", "kept_previous"] },
    "statusReason": { "type": "string" }
  }
}
