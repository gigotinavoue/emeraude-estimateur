{
  "$id": "mobilite-loyer.schema.json",
  "description": "config/mobilite-loyer.json — calcul automatique du loyer conseillé en bail mobilité. Indépendant de config/config.json.",
  "type": "object",
  "required": ["schemaVersion", "version", "methode", "sources", "segments", "meuble", "mobilite", "criteres", "confiance", "bornes", "arrondiEuros", "texts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^mobilite-loyer-\\d+\\.\\d+\\.\\d+$" },
    "methode": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sources": { "type": "object", "required": ["carteLoyers", "anilMeuble"] },
    "segments": { "type": "object", "required": ["app12", "app3", "mai", "nature"] },
    "meuble": {
      "type": "object",
      "required": ["nature", "defaut", "parCommune", "justification"],
      "properties": { "defaut": { "type": "number", "minimum": 0, "maximum": 0.3 }, "justification": { "type": "string", "minLength": 20 } }
    },
    "mobilite": {
      "type": "object",
      "required": ["nature", "valeur", "justification"],
      "properties": { "nature": { "const": "HYPOTHÈSE" }, "valeur": { "type": "number", "minimum": -0.3, "maximum": 0.3 } }
    },
    "criteres": {
      "type": "object",
      "required": ["nature", "note", "plafond", "choix", "etage", "equipements", "obligatoires", "sansEffet"],
      "properties": {
        "nature": { "const": "HYPOTHÈSE" },
        "plafond": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -0.3, "maximum": 0.3 } }
      }
    },
    "confiance": { "type": "object", "required": ["minAnnonces", "niveaux", "zFourchette", "note"] },
    "bornes": { "type": "object", "required": ["surface", "pieces", "chambres", "capacite"] },
    "arrondiEuros": { "type": "number", "minimum": 1 },
    "texts": { "type": "object", "required": ["avertissement", "forfait", "personnalise"] }
  }
}
