{
  "$id": "emeraude-private.schema.json",
  "description": "Ligne du fichier PRIVÉ data/emeraude/private/listings_monthly.csv (un logement × un mois). Ce fichier n'est jamais publié ; seul data/emeraude/aggregates.json (≥ 3 logements par segment) peut l'être.",
  "type": "object",
  "required": ["listing_ref", "commune_insee", "type", "bedrooms", "bathrooms", "guests", "area_m2", "location_level", "amenities", "month", "nights_available", "nights_booked", "revenue_nights_eur", "cleaning_collected_eur"],
  "properties": {
    "listing_ref": { "type": "string", "minLength": 1 },
    "commune_insee": { "type": "string", "pattern": "^\\d{5}$" },
    "epci": { "type": "string" },
    "type": { "enum": ["studio", "t1", "t2", "t3", "t4", "maison"] },
    "bedrooms": { "type": "string", "pattern": "^\\d+$" },
    "bathrooms": { "type": "string", "pattern": "^\\d+$" },
    "guests": { "type": "string", "pattern": "^\\d+$" },
    "area_m2": { "type": "string", "pattern": "^\\d+([.,]\\d+)?$" },
    "location_level": { "enum": ["hypercentre", "tres-central", "central", "quartier-recherche", "standard", "peripherie"] },
    "amenities": { "type": "string" },
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "nights_available": { "type": "string", "pattern": "^\\d+$" },
    "nights_booked": { "type": "string", "pattern": "^\\d+$" },
    "revenue_nights_eur": { "type": "string", "pattern": "^\\d+([.,]\\d+)?$" },
    "cleaning_collected_eur": { "type": "string", "pattern": "^\\d+([.,]\\d+)?$" },
    "stays": { "type": "string" },
    "airbnb_fees_eur": { "type": "string" },
    "source": { "type": "string" },
    "nights_blocked_owner": { "type": "string" },
    "nights_blocked_other": { "type": "string" },
    "blocked_note": { "type": "string" },
    "platform": { "type": "string" },
    "commission_eur": { "type": "string" },
    "cleaning_cost_eur": { "type": "string" },
    "owner_payout_eur": { "type": "string" },
    "rating": { "type": "string" },
    "reviews_count": { "type": "string" },
    "managed_since": { "type": "string" }
  }
}
